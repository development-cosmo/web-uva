---
import { Github, Twitter, Linkedin, Mail, MapPin, Phone, ArrowUpRight } from 'lucide-react';

const currentYear = new Date().getFullYear();

const navSections = [
  {
    title: 'Soluciones',
    links: [
      { label: 'Desarrollo Web Moderno', href: '/servicios/desarrollo-web-moderno/' },
      { label: 'Arquitectura Cloud & DevOps', href: '/servicios/arquitectura-cloud-devops/' },
      { label: 'Consultoría SEO & GEO', href: '/servicios/consultoria-seo-tecnico/' },
      { label: 'Integración IA & LLMs', href: '/servicios/ia-integracion-llms/' },
    ],
  },
  {
    title: 'Compañía',
    links: [
      { label: 'Sobre Nosotros', href: '/nosotros/' },
      { label: 'Casos de Éxito', href: '/proyectos/' },
      { label: 'Blog & Recursos', href: '/blog/' },
      { label: 'Contacto Directo', href: '/contacto/' },
    ],
  },
  {
    title: 'IA & Rastreabilidad',
    links: [
      { label: 'Archivo llms.txt', href: '/llms.txt', external: true },
      { label: 'Robots.txt', href: '/robots.txt', external: true },
      { label: 'Sitemap XML', href: '/sitemap-index.xml', external: true },
    ],
  },
];
---

<footer class="bg-gray-950 text-gray-300 pt-16 pb-12 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-12 border-b border-gray-800">
      
      <!-- Columna Corporativa -->
      <div class="lg:col-span-2 space-y-6">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary-600 to-accent-500 flex items-center justify-center text-white shadow-lg">
            <span class="font-bold text-lg">U</span>
          </div>
          <div>
            <span class="text-2xl font-bold text-white tracking-tight block">
              UVA<span class="text-accent-500">.</span>
            </span>
            <span class="text-[10px] text-gray-400 uppercase tracking-widest block font-medium">
              Tech Solutions
            </span>
          </div>
        </a>

        <p class="text-sm text-gray-400 max-w-sm leading-relaxed">
          Diseñamos y desarrollamos productos digitales de alto impacto con Astro, TypeScript y React. Rendimiento extremo, optimización GEO y arquitecturas preparadas para el futuro.
        </p>

        <div class="flex items-center gap-4 text-gray-400">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition p-2 bg-gray-900 rounded-lg hover:bg-gray-800" aria-label="GitHub">
            <Github class="w-4 h-4" />
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition p-2 bg-gray-900 rounded-lg hover:bg-gray-800" aria-label="Twitter">
            <Twitter class="w-4 h-4" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition p-2 bg-gray-900 rounded-lg hover:bg-gray-800" aria-label="LinkedIn">
            <Linkedin class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columnas de Enlaces -->
      {navSections.map((section) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-white mb-4">
            {section.title}
          </p>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : '_self'}
                  rel={link.external ? 'noopener noreferrer' : ''}
                  class="text-sm text-gray-400 hover:text-white transition inline-flex items-center gap-1 group"
                >
                  {link.label}
                  {link.external && <ArrowUpRight class="w-3 h-3 text-gray-500 group-hover:text-white transition" />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Barra Inferior -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4">
      <p>© {currentYear} UVA Tech Solutions S.L. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/nosotros/" class="hover:text-gray-400 transition">Aviso Legal</a>
        <a href="/nosotros/" class="hover:text-gray-400 transition">Política de Privacidad</a>
        <a href="/llms.txt" class="hover:text-accent-400 transition flex items-center gap-1 text-accent-500">
          llms.txt compatible
        </a>
      </div>
    </div>
  </div>
</footer>


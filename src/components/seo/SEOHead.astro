---
export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalURL?: string;
  publishDate?: Date;
  author?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  image = 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80',
  type = 'website',
  canonicalURL = Astro.url.href,
  publishDate,
  author,
  schema,
} = Astro.props;

const siteTitle = `${title} | UVA Tech Solutions`;
const siteUrl = 'https://www.tudominio.com';

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UVA Tech Solutions',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Consultoría y desarrollo de software de alta gama con Astro, TypeScript y React.',
  sameAs: [
    'https://github.com/uva-tech',
    'https://twitter.com/uvatech',
    'https://linkedin.com/company/uvatech',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+34-900-123-456',
    contactType: 'customer service',
    availableLanguage: ['Spanish', 'English'],
  },
};

const finalSchema = schema || defaultSchema;
---

<!-- Metadatos Principales -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="UVA Tech Solutions" />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta name="twitter:creator" content="@uvatech" />

<!-- GEO & IA Metadata -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="ai-content-declaration" content="human-crafted, ai-assisted" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="Contexto para Modelos de Lenguaje (LLMs)" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />


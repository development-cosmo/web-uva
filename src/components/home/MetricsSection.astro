---
const stats = [
  { value: '100%', label: 'Puntuación Lighthouse', note: 'En rendimiento y SEO' },
  { value: '< 1.2s', label: 'LCP Promedio', note: 'Largest Contentful Paint' },
  { value: '0 kB', label: 'JS Client por Defecto', note: 'Arquitectura Zero-JS' },
  { value: '99.99%', label: 'Disponibilidad Edge', note: 'Red Global Cloudflare' },
];
---

<section class="py-16 bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-gray-800">
      {stats.map((stat) => (
        <div class="pt-6 md:pt-0 md:px-6 first:pl-0 text-center md:text-left">
          <p class="text-4xl sm:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-accent-400 mb-2">
            {stat.value}
          </p>
          <p class="text-sm font-bold text-white mb-1">{stat.label}</p>
          <p class="text-xs text-gray-400">{stat.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>


---
import { getCollection } from 'astro:content';
import { ArrowRight, Code2, Cloud, Search, Cpu } from 'lucide-react';

const services = await getCollection('services');

const iconMap = {
  Code2,
  Cloud,
  Search,
  Cpu,
};
---

<section class="py-20 md:py-28 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-primary-600 mb-2">
          Nuestras Especialidades
        </p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
          Ingeniería de Software de Clase Mundial
        </h2>
      </div>
      <a
        href="/servicios/"
        class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-semibold text-primary-600 hover:text-primary-700 group"
      >
        Ver catálogo completo
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => {
        const IconComponent = iconMap[service.data.icon as keyof typeof iconMap] || Code2;
        return (
          <div class="group p-8 rounded-2xl bg-gray-50/50 hover:bg-white border border-gray-100 hover:border-primary-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-primary-100/50 text-primary-700 flex items-center justify-center mb-6 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
                <IconComponent class="w-6 h-6" />
              </div>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 block mb-2">
                {service.data.category}
              </span>
              <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">
                {service.data.title}
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed mb-6">
                {service.data.description}
              </p>
            </div>

            <a
              href={`/servicios/${service.slug}/`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary-600 group-hover:text-primary-700 mt-4"
            >
              Conocer detalles
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>


---
import { ArrowRight, ShieldCheck, Zap, Sparkles } from 'lucide-react';
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32 bg-gradient-to-b from-primary-50/50 via-white to-white">
  <!-- Círculos decorativos de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-200/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-accent-200/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge Píldora Superior -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-primary-200/60 shadow-sm text-xs font-semibold text-primary-700 mb-8 animate-fade-in">
      <Sparkles class="w-4 h-4 text-accent-500" />
      <span>Especialistas en Astro + TypeScript + GEO</span>
      <span class="w-1.5 h-1.5 rounded-full bg-accent-500"></span>
      <span class="text-gray-500 font-normal">Cloudflare Ready</span>
    </div>

    <!-- Título Principal -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold text-gray-900 tracking-tight leading-[1.1] mb-8 max-w-4xl mx-auto">
      Rendimiento Web <span class="bg-gradient-to-r from-primary-600 via-primary-700 to-accent-500 bg-clip-text text-transparent">Extremo</span> y Arquitectura para la Era IA.
    </h1>

    <!-- Subtítulo -->
    <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      Transformamos plataformas corporativas con la arquitectura de islas de Astro y reactividad selectiva en React. Sitios con puntuación 100/100 en Core Web Vitals y optimización GEO para buscadores y LLMs.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="/servicios/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/35 group"
      >
        Explorar Servicios
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
      <a
        href="/contacto/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-gray-50 text-gray-800 font-semibold rounded-xl border border-gray-200 transition shadow-sm hover:shadow"
      >
        Solicitar Auditoría Gratis
      </a>
    </div>

    <!-- Puntos de Confianza -->
    <div class="pt-8 border-t border-gray-100 flex flex-wrap items-center justify-center gap-8 text-xs font-medium text-gray-500">
      <div class="flex items-center gap-2">
        <Zap class="w-4 h-4 text-accent-500" />
        <span>LCP inferior a 1.2 segundos</span>
      </div>
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-green-500" />
        <span>Validación estricta con Zod</span>
      </div>
      <div class="flex items-center gap-2">
        <Sparkles class="w-4 h-4 text-primary-600" />
        <span>Contexto enriquecido llms.txt</span>
      </div>
    </div>
  </div>
</section>


---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactForm from '@/components/contact/ContactForm';
import { Mail, Phone, MapPin, MessageSquare, Clock } from 'lucide-react';
---

<MainLayout
  title="Contacto Directo"
  description="Contacta con los ingenieros y arquitectos de UVA Tech Solutions. Solicita una auditoría o propuesta técnica personalizada."
>
  <div class="py-20 md:py-28 bg-gradient-to-b from-primary-50/40 via-white to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Información de Contacto -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="px-3.5 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold uppercase tracking-wider inline-block mb-4">
              Canal Oficial
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-6">
              Hablemos de tu próximo proyecto.
            </h1>
            <p class="text-base text-gray-600 leading-relaxed">
              ¿Quieres migrar tu sitio a Astro, implementar una arquitectura GEO o mejorar la puntuación en Core Web Vitals? Cuéntanos tu desafío y te responderemos con un diagnóstico técnico.
            </p>
          </div>

          <div class="space-y-6 pt-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                <Mail class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-400">Email Directo</p>
                <a href="mailto:contacto@tudominio.com" class="text-sm font-bold text-gray-900 hover:text-primary-600 transition">
                  contacto@tudominio.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-400">Teléfono / WhatsApp</p>
                <p class="text-sm font-bold text-gray-900">+34 900 123 456</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                <Clock class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-400">Tiempo de Respuesta</p>
                <p class="text-sm font-bold text-gray-900">Menos de 24 horas laborables</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider font-semibold text-gray-400">Ubicación</p>
                <p class="text-sm font-bold text-gray-900">Madrid, España (Servicio Global Remoto)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario React Interactivo -->
        <div class="lg:col-span-7">
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </div>
</MainLayout>


---
import MainLayout from '@/layouts/MainLayout.astro';
import { Shield, Zap, Target, Users, CheckCircle, Code } from 'lucide-react';

const values = [
  {
    icon: Zap,
    title: 'Rendimiento Innegociable',
    description: 'No medimos el éxito en cantidad de JavaScript cargado, sino en milisegundos de respuesta para el usuario final.',
  },
  {
    icon: Code,
    title: 'Tipado Fuerte & Robustez',
    description: 'TypeScript estricto y esquemas Zod en todas las capas. Reducimos al mínimo los errores en producción.',
  },
  {
    icon: Target,
    title: 'GEO & Rastreabilidad IA',
    description: 'Construimos sitios web preparados para ser leídos tanto por personas como por motores de inteligencia artificial.',
  },
  {
    icon: Users,
    title: 'Colaboración Transparente',
    description: 'Trabajamos como una extensión de tu equipo técnico con comunicación directa y entregables claros.',
  },
];

const team = [
  {
    name: 'Carlos Mendoza',
    role: 'Lead Frontend Architect & Fundador',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80',
    bio: 'Ex-ingeniero senior especializado en Astro, React y rendimiento web en arquitecturas Jamstack.',
  },
  {
    name: 'Elena Morales',
    role: 'Head of SEO Técnico & GEO',
    avatar: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=300&q=80',
    bio: 'Especialista en Schema.org, visibilidad de entidades y rastreo para modelos de lenguaje generativos.',
  },
  {
    name: 'Javier Vega',
    role: 'DevOps & Cloud Engineer',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=300&q=80',
    bio: 'Experto en Edge Computing, Cloudflare Pages, serverless y automatización continua.',
  },
];
---

<MainLayout
  title="Sobre Nosotros"
  description="Conoce al equipo detrás de UVA Tech Solutions. Diseñamos productos digitales ultra-rápidos con Astro, TypeScript y React."
>
  <!-- Hero Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-primary-50/40 via-white to-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="px-4 py-1.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold uppercase tracking-wider mb-6 inline-block">
        Quiénes Somos
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-gray-900 tracking-tight mb-8">
        Ingeniería con propósito: Menos fricción, más velocidad.
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        UVA Tech Solutions nació con una premisa clara: la web contemporánea se ha vuelto pesada e ineficiente. Ayudamos a empresas visionarias a recuperar la agilidad con tecnologías estáticas modernas y reactividad selectiva.
      </p>
    </div>
  </section>

  <!-- Filosofía y Valores -->
  <section class="py-20 bg-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Nuestros Principios de Ingeniería</h2>
        <p class="text-sm text-gray-600">
          Cada línea de código que escribimos responde a estándares estrictos de calidad y sostenibilidad tecnológica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((v) => {
          const Icon = v.icon;
          return (
            <div class="p-8 rounded-2xl bg-gray-50/80 border border-gray-100 hover:border-primary-200 hover:shadow-lg transition">
              <div class="w-12 h-12 rounded-xl bg-primary-600 text-white flex items-center justify-center mb-6 shadow-md">
                <Icon class="w-6 h-6" />
              </div>
              <h3 class="text-base font-bold text-gray-900 mb-2">{v.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{v.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="py-20 md:py-28 bg-gray-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-accent-600 mb-2 block">
          Liderazgo Técnico
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
          Un equipo enfocado en la excelencia
        </h2>
        <p class="text-sm text-gray-600">
          Profesionales apasionados por la arquitectura web, el SEO técnico y la inteligencia artificial aplicada.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {team.map((member) => (
          <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm text-center flex flex-col items-center">
            <img
              src={member.avatar}
              alt={member.name}
              class="w-24 h-24 rounded-full object-cover mb-6 border-2 border-primary-100 shadow-md"
            />
            <h3 class="text-lg font-bold text-gray-900 mb-1">{member.name}</h3>
            <p class="text-xs font-semibold text-primary-600 mb-4">{member.role}</p>
            <p class="text-xs text-gray-500 leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

